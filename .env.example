# Telegram API credentials
API_ID=12345678
API_HASH=your_api_hash

# Telethon user session
STRING_SESSION=your_telethon_string_session

# Telegram bot token
BOT_TOKEN=123456:your_bot_token

# Destination channel ID or username
# Example: -1001234567890
TARGET_CHANNEL=-1001234567890

# Authorized Telegram user IDs (comma-separated)
ALLOWED_USERS=123456789,987654321

# Maximum video resolution
MAX_RES=1080

# Compress videos larger than this size (MB)
COMPRESS_ABOVE_MB=500

# Remove branding and metadata
CLEAN=true

# Storage directories
DOWNLOAD_DIR=downloads
DATABASE_PATH=data/database.sqlite3

# Render web service port
PORT=8080

# Logging
LOG_LEVEL=INFO
